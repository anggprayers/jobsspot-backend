NODE_ENV=development
PORT=4000

# Public frontend origin used in email links and as the primary CORS origin.
FRONTEND_URL=http://localhost:3000
# Optional comma-separated additional browser origins (for example www/preview domains).
CORS_ALLOWED_ORIGINS=
# Number of trusted reverse-proxy hops in production. Render normally uses one hop.
TRUST_PROXY_HOPS=1
# Use "none" when frontend/API are cross-site. Use "lax" when production API is on api.jobsspot.net.
REFRESH_COOKIE_SAME_SITE=none

# Runtime Prisma Client URL (use the Neon pooled connection string).
DATABASE_URL=
# Prisma migrate URL (use the Neon direct/non-pooler connection string).
DIRECT_URL=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=jobsspot-resumes

INTERNAL_CRON_SECRET=

RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
CONTACT_INBOX_EMAIL=jeff@jobsspot.net
EMAIL_LOGO_URL=

EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=30
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

GOOGLE_CLIENT_ID=

COMPANY_INVITATION_TOKEN_TTL_DAYS=7
COMPANY_INVITATION_RESEND_COOLDOWN_MINUTES=15
COMPANY_INVITATION_RECIPIENT_DAILY_LIMIT=3
COMPANY_INVITATION_COMPANY_DAILY_LIMIT=50
