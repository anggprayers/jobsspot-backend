generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OAuthProvider {
  GOOGLE
}

enum CompanyMemberRole {
  OWNER
  ADMIN
  RECRUITER
  VIEWER
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  TEMPORARY
  INTERNSHIP
}

enum WorkplaceType {
  ONSITE
  REMOTE
  HYBRID
}

enum ExperienceLevel {
  ENTRY_LEVEL
  JUNIOR
  MID_LEVEL
  SENIOR
  LEAD
  EXECUTIVE
}

enum JobStatus {
  DRAFT
  PUBLISHED
  PAUSED
  CLOSED
  ARCHIVED
}

enum SalaryPeriod {
  HOURLY
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  SHORTLISTED
  INTERVIEW
  OFFERED
  HIRED
  REJECTED
  WITHDRAWN
}

enum SavedSearchAlertFrequency {
  DAILY
  WEEKLY
}

enum NotificationAudience {
  JOB_SEEKER
  EMPLOYER
  ADMIN
  SYSTEM
}

enum JobReportReason {
  SCAM_FRAUD
  MISLEADING
  DISCRIMINATION
  SPAM_DUPLICATE
  INAPPROPRIATE
  OTHER
}

enum JobReportStatus {
  PENDING
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

enum JobSubmissionStatus {
  SUBMITTED
  CONTACTED
  APPROVED
  REJECTED
  PUBLISHED
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique
  passwordHash    String?
  firstName       String
  lastName        String
  phone           String?
  avatarUrl       String?
  isEmailVerified Boolean   @default(false)
  isAdmin         Boolean   @default(false)
  suspendedAt     DateTime?
  suspensionReason String?
  suspendedById   String?   @db.Uuid
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  jobSeekerProfile        JobSeekerProfile?
  oauthAccounts           OAuthAccount[]
  resumes                 Resume[]
  companyMemberships      CompanyMembership[]
  createdJobs             Job[]                    @relation("JobCreatedBy")
  applications            Application[]
  savedJobs               SavedJob[]
  savedSearches           SavedSearch[]
  refreshTokens           RefreshToken[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  auditLogs               AuditLog[]               @relation("AuditLogActor")
  sentCompanyInvitations  CompanyInvitation[]      @relation("CompanyInvitationInvitedBy")
  acceptedCompanyInvitations CompanyInvitation[]    @relation("CompanyInvitationAcceptedBy")
  suspendedBy             User?                    @relation("UserSuspendedBy", fields: [suspendedById], references: [id], onDelete: SetNull)
  suspendedUsers          User[]                   @relation("UserSuspendedBy")
  suspendedCompanies      Company[]                @relation("CompanySuspendedBy")
  platformAuditLogs       PlatformAuditLog[]       @relation("PlatformAuditActor")
  notifications           Notification[]
  notificationPreference  NotificationPreference?
  adminHiddenJobs         Job[]                    @relation("JobAdminHiddenBy")
  jobReports              JobReport[]              @relation("JobReportReporter")
  reviewedJobReports      JobReport[]              @relation("JobReportReviewedBy")
  reviewedJobSubmissions  JobSubmission[]          @relation("JobSubmissionReviewedBy")
  createdApplicationShareLinks ApplicationShareLink[] @relation("ApplicationShareCreatedBy")

  @@index([deletedAt])
  @@index([suspendedAt])
  @@index([suspendedById])
}

model EmailVerificationToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model OAuthAccount {
  id                String        @id @default(uuid()) @db.Uuid
  userId            String        @db.Uuid
  provider          OAuthProvider
  providerAccountId String
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
  @@index([userId])
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  tokenId    String    @unique
  userId     String    @db.Uuid
  tokenHash  String    @unique
  deviceInfo String?
  ipAddress  String?
  userAgent  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model JobSeekerProfile {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @unique @db.Uuid
  headline          String?
  summary           String?
  location          String?
  websiteUrl        String?
  linkedInUrl       String?
  yearsOfExperience Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills          JobSeekerSkill[]
  workExperiences WorkExperience[]
  educations      Education[]
  certifications  Certification[]
}

model JobSeekerSkill {
  profileId         String   @db.Uuid
  skillId           String   @db.Uuid
  yearsOfExperience Int?
  createdAt         DateTime @default(now())

  profile JobSeekerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skill   Skill            @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([profileId, skillId])
  @@index([skillId])
}

model WorkExperience {
  id             String          @id @default(uuid()) @db.Uuid
  profileId      String          @db.Uuid
  jobTitle       String
  companyName    String
  employmentType EmploymentType?
  location       String?
  startDate      DateTime
  endDate        DateTime?
  isCurrent      Boolean         @default(false)
  description    String?
  displayOrder   Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  profile JobSeekerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, displayOrder])
}

model Education {
  id              String    @id @default(uuid()) @db.Uuid
  profileId       String    @db.Uuid
  institutionName String
  degree          String?
  fieldOfStudy    String?
  startDate       DateTime?
  endDate         DateTime?
  isCurrent       Boolean   @default(false)
  description     String?
  displayOrder    Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  profile JobSeekerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, displayOrder])
}

model Certification {
  id                  String    @id @default(uuid()) @db.Uuid
  profileId           String    @db.Uuid
  name                String
  issuingOrganization String?
  issueDate           DateTime?
  expirationDate      DateTime?
  credentialId        String?
  credentialUrl       String?
  displayOrder        Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  profile JobSeekerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, displayOrder])
}

model Resume {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  name      String
  fileKey   String    @unique
  fileUrl   String?
  mimeType  String
  fileSize  Int
  isDefault Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications Application[]

  @@index([userId, createdAt])
  @@index([deletedAt])
}

model Company {
  id          String  @id @default(uuid()) @db.Uuid
  name        String
  slug        String  @unique
  description String?
  websiteUrl  String?

  logoUrl      String?
  logoPublicId String?

  bannerUrl      String?
  bannerPublicId String?

  industry    String?
  companySize String?
  location    String?
  isVerified       Boolean   @default(false)
  suspendedAt      DateTime?
  suspensionReason String?
  suspendedById    String?   @db.Uuid
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  memberships CompanyMembership[]
  jobs        Job[]
  auditLogs   AuditLog[]
  invitations CompanyInvitation[]
  jobSubmissions JobSubmission[]
  suspendedBy User?               @relation("CompanySuspendedBy", fields: [suspendedById], references: [id], onDelete: SetNull)

  @@index([name])
  @@index([deletedAt])
  @@index([suspendedAt])
  @@index([suspendedById])
}

model CompanyMembership {
  id        String            @id @default(uuid()) @db.Uuid
  companyId String            @db.Uuid
  userId    String            @db.Uuid
  role      CompanyMemberRole @default(RECRUITER)
  joinedAt  DateTime          @default(now())
  deletedAt DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@index([userId])
  @@index([companyId, role])
  @@index([deletedAt])
}


model CompanyInvitation {
  id           String            @id @default(uuid()) @db.Uuid
  companyId    String            @db.Uuid
  email        String
  role         CompanyMemberRole
  tokenHash    String            @unique
  invitedById  String            @db.Uuid
  acceptedById String?           @db.Uuid
  expiresAt    DateTime
  lastSentAt   DateTime?
  sendCount    Int               @default(0)
  acceptedAt   DateTime?
  cancelledAt  DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  company    Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invitedBy  User    @relation("CompanyInvitationInvitedBy", fields: [invitedById], references: [id], onDelete: Restrict)
  acceptedBy User?   @relation("CompanyInvitationAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@unique([companyId, email])
  @@index([companyId, acceptedAt, cancelledAt, expiresAt])
  @@index([invitedById])
  @@index([acceptedById])
  @@index([expiresAt])
}

model AuditLog {
  id               String   @id @default(uuid()) @db.Uuid
  companyId        String   @db.Uuid
  actorUserId      String?  @db.Uuid
  actorDisplayName String
  actorEmail       String
  action           String
  entityType       String
  entityId         String?
  metadata         Json?
  createdAt        DateTime @default(now())

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  actorUser User?   @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([actorUserId])
  @@index([action])
  @@index([entityType, entityId])
}

model JobCategory {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @unique
  slug         String   @unique
  isActive     Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  jobs          Job[]
  savedSearches SavedSearch[]

  @@index([isActive, displayOrder, name])
}

model PlatformAuditLog {
  id               String   @id @default(uuid()) @db.Uuid
  actorUserId      String?  @db.Uuid
  actorDisplayName String
  actorEmail       String
  action           String
  entityType       String
  entityId         String?
  metadata         Json?
  createdAt        DateTime @default(now())

  actorUser User? @relation("PlatformAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorUserId])
  @@index([action])
  @@index([entityType, entityId])
}

model Notification {
  id         String               @id @default(uuid()) @db.Uuid
  userId     String               @db.Uuid
  audience   NotificationAudience
  type       String
  eventKey   String
  title      String
  message    String
  actionUrl  String?
  entityType String?
  entityId   String?
  metadata   Json?
  readAt     DateTime?
  clearedAt  DateTime?
  emailedAt  DateTime?
  emailProcessedAt DateTime?
  createdAt  DateTime             @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventKey])
  @@index([userId, audience, readAt, createdAt])
  @@index([userId, audience, clearedAt, createdAt])
  @@index([userId, createdAt])
  @@index([entityType, entityId])
}

model NotificationPreference {
  id                               String   @id @default(uuid()) @db.Uuid
  userId                           String   @unique @db.Uuid
  jobSeekerApplicationUpdatesEmail Boolean  @default(true)
  jobSeekerApplicationViewedEmail  Boolean  @default(false)
  employerApplicationEmail         Boolean  @default(true)
  employerTeamEmail                Boolean  @default(true)
  employerJobEmail                 Boolean  @default(true)
  systemEmail                      Boolean  @default(true)
  createdAt                        DateTime @default(now())
  updatedAt                        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

}

model Job {
  id                  String          @id @default(uuid()) @db.Uuid
  companyId           String          @db.Uuid
  categoryId          String          @db.Uuid
  createdById         String          @db.Uuid
  title               String
  slug                String          @unique
  description         String
  requirements        String?
  responsibilities    String?
  employmentType      EmploymentType
  workplaceType       WorkplaceType
  experienceLevel     ExperienceLevel
  location            String?
  city                String?
  stateRegion         String?
  countryCode         String          @default("US") @db.VarChar(2)
  salaryMin           Decimal?        @db.Decimal(12, 2)
  salaryMax           Decimal?        @db.Decimal(12, 2)
  salaryCurrency      String?         @db.VarChar(3)
  salaryPeriod        SalaryPeriod?
  status              JobStatus       @default(DRAFT)
  applicationDeadline DateTime?
  publicContactEmail  String?         @db.VarChar(254)
  publishedAt         DateTime?
  expiresAt           DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  deletedAt           DateTime?
  adminHiddenAt       DateTime?
  adminHiddenReason   String?
  adminHiddenById     String?         @db.Uuid

  company       Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  category     JobCategory   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdBy     User          @relation("JobCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  adminHiddenBy User?         @relation("JobAdminHiddenBy", fields: [adminHiddenById], references: [id], onDelete: SetNull)
  skills        JobSkill[]
  applications  Application[]
  savedByUsers  SavedJob[]
  reports       JobReport[]
  jobSubmission JobSubmission?

  @@index([status, publishedAt])
  @@index([companyId, status])
  @@index([categoryId, status])
  @@index([employmentType])
  @@index([workplaceType])
  @@index([experienceLevel])
  @@index([location])
  @@index([countryCode, stateRegion, city])
  @@index([createdById])
  @@index([deletedAt])
  @@index([adminHiddenAt])
  @@index([adminHiddenById])
}

model Skill {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobs       JobSkill[]
  jobSeekers JobSeekerSkill[]
}

model JobSkill {
  jobId      String  @db.Uuid
  skillId    String  @db.Uuid
  isRequired Boolean @default(true)

  job   Job   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([jobId, skillId])
  @@index([skillId])
}

model Application {
  id          String            @id @default(uuid()) @db.Uuid
  jobId       String            @db.Uuid
  applicantId String            @db.Uuid
  resumeId    String?           @db.Uuid
  coverLetter             String?
  coverLetterFileKey      String?
  coverLetterFileName     String?
  coverLetterFileMimeType String?
  coverLetterFileSize     Int?
  status                  ApplicationStatus @default(SUBMITTED)
  appliedAt   DateTime          @default(now())
  reviewedAt   DateTime?
  firstViewedAt DateTime?
  withdrawnAt  DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  job       Job     @relation(fields: [jobId], references: [id], onDelete: Restrict)
  applicant User    @relation(fields: [applicantId], references: [id], onDelete: Restrict)
  resume    Resume? @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  shareLinks ApplicationShareLink[]

  @@index([jobId, applicantId, appliedAt])
  @@index([jobId, status])
  @@index([applicantId, createdAt])
  @@index([resumeId])
  @@index([firstViewedAt])
}


model ApplicationShareLink {
  id                 String   @id @default(uuid()) @db.Uuid
  applicationId      String   @db.Uuid
  createdById        String   @db.Uuid
  tokenHash          String   @unique
  includeResume      Boolean  @default(true)
  includeCoverLetter Boolean  @default(false)
  expiresAt          DateTime
  revokedAt          DateTime?
  lastAccessedAt     DateTime?
  accessCount        Int      @default(0)
  createdAt          DateTime @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  createdBy   User        @relation("ApplicationShareCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([applicationId, createdAt])
  @@index([createdById, createdAt])
  @@index([expiresAt])
  @@index([revokedAt])
}

model JobSubmission {
  id               String              @id @default(uuid()) @db.Uuid
  referenceCode    String              @unique @db.VarChar(32)
  jobTitle         String
  companyName      String
  companyWebsite   String?
  locationText     String
  workplaceType    WorkplaceType
  employmentType   EmploymentType
  salaryText       String?
  description      String
  contactName      String?
  contactEmail     String
  contactPhone     String?
  status           JobSubmissionStatus @default(SUBMITTED)
  internalNotes    String?
  reviewedById     String?             @db.Uuid
  reviewedAt       DateTime?
  contactedAt      DateTime?
  approvedAt       DateTime?
  rejectedAt       DateTime?
  publishedAt      DateTime?
  companyId        String?             @db.Uuid
  publishedJobId   String?             @unique @db.Uuid
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  reviewedBy   User?    @relation("JobSubmissionReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  company      Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  publishedJob Job?     @relation(fields: [publishedJobId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([contactEmail, createdAt])
  @@index([companyId])
  @@index([reviewedById])
}

model JobReport {
  id             String          @id @default(uuid()) @db.Uuid
  jobId          String          @db.Uuid
  reporterUserId String          @db.Uuid
  reason         JobReportReason
  details        String?
  status         JobReportStatus @default(PENDING)
  resolutionNote String?
  reviewedById   String?         @db.Uuid
  reviewedAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  job        Job   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  reporter   User  @relation("JobReportReporter", fields: [reporterUserId], references: [id], onDelete: Restrict)
  reviewedBy User? @relation("JobReportReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([jobId, reporterUserId])
  @@index([status, createdAt])
  @@index([reason, createdAt])
  @@index([jobId, status])
  @@index([reviewedById])
}

model SavedJob {
  userId    String   @db.Uuid
  jobId     String   @db.Uuid
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@id([userId, jobId])
  @@index([jobId])
}

model SavedSearch {
  id                  String                     @id @default(uuid()) @db.Uuid
  userId              String                     @db.Uuid
  categoryId          String?                    @db.Uuid
  name                String
  keyword             String?
  location            String?

  // Legacy single-value fields remain for backward compatibility.
  employmentType      EmploymentType?
  workplaceType       WorkplaceType?
  experienceLevel     ExperienceLevel?

  // Current multi-select filters.
  categorySlugs       String[]                   @default([])
  employmentTypes     EmploymentType[]           @default([])
  workplaceTypes      WorkplaceType[]            @default([])
  experienceLevels    ExperienceLevel[]           @default([])

  salaryMin           Decimal?                   @db.Decimal(12, 2)
  salaryMax           Decimal?                   @db.Decimal(12, 2)
  salaryCurrency      String?                    @db.VarChar(3)
  salaryPeriod        SalaryPeriod?
  publishedWithinDays Int?

  emailAlertsEnabled  Boolean                    @default(false)
  alertFrequency      SavedSearchAlertFrequency?
  lastAlertSentAt     DateTime?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  deletedAt           DateTime?

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  category JobCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([categoryId])
  @@index([emailAlertsEnabled, alertFrequency, lastAlertSentAt])
  @@index([deletedAt])
}


model PopularSearch {
  id             String   @id @default(uuid()) @db.Uuid
  keyword        String
  normalizedTerm String   @unique
  searchCount    Int      @default(0)
  lastSearchedAt DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  dailyCounts PopularSearchDailyCount[]

  @@index([searchCount, lastSearchedAt])
  @@index([lastSearchedAt])
}

model PopularSearchDailyCount {
  id              String   @id @default(uuid()) @db.Uuid
  popularSearchId String   @db.Uuid
  searchDate      DateTime @db.Date
  searchCount     Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  popularSearch PopularSearch @relation(fields: [popularSearchId], references: [id], onDelete: Cascade)

  @@unique([popularSearchId, searchDate])
  @@index([searchDate, searchCount])
  @@index([popularSearchId])
}
